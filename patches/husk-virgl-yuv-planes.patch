+#if !(defined(HAVE_EPOXY_EGL_H) && defined(ENABLE_GBM_ALLOCATION))
+static inline uint8_t vrend_clamp_u8(int v)
+{
+   return v < 0 ? 0 : (v > 255 ? 255 : (uint8_t)v);
+}
+
+/* A frame arrives the way virgl_gbm_transfer expects it on a GBM host: the luma stride in `stride`, or
+ * in `level` (the kernel does not pass the stride, so minigbm smuggles it there), and the planes back
+ * to back -- Y, then V and U for YV12 (each at half the stride), or Y then interleaved UV for NV12 --
+ * each `layer_stride`-sized if that is given, packed otherwise. The whole frame is taken, whatever the
+ * box: the guest's backing always holds all of it, and a video frame is always written whole.
+ *
+ * Each plane goes to its own texture as it is (the guest's shader converts). Only if something samples
+ * the resource whole is it also converted to RGBA here: limited-range BT.601 below 720 lines and BT.709
+ * from there, as players guess when the stream does not say. Reading back is a no-op, because the
+ * guest's own backing already holds the YUV it wrote and there is nothing better to return. */
+static void vrend_yuv_upload_plane(GLuint tex, GLenum glformat, uint32_t bpp, uint32_t width,
+                                   uint32_t height, const uint8_t *src, uint32_t src_stride,
+                                   bool invert, uint8_t *scratch)
+{
+   const uint32_t row = width * bpp;
+   for (uint32_t y = 0; y < height; y++)
+      memcpy(scratch + (size_t)(invert ? height - 1 - y : y) * row, src + (size_t)y * src_stride, row);
+   glBindTexture(GL_TEXTURE_2D, tex);
+   glTexSubImage2D(GL_TEXTURE_2D, 0, 0, 0, width, height, glformat, GL_UNSIGNED_BYTE, scratch);
+}
+
+static void vrend_yuv_to_rgba(const struct vrend_resource *res, const uint8_t *yuv, uint32_t stride,
+                              uint32_t cstride, uint64_t c0, uint64_t c1, bool invert, uint8_t *rgba)
+{
+   const bool nv12 = res->base.format == VIRGL_FORMAT_NV12;
+   const uint32_t w = res->base.width0, h = res->base.height0;
+   /* Fixed point, x1024. */
+   const bool bt709 = h >= 720;
+   const int cy = 1192;                              /* 1.164 */
+   const int crv = bt709 ? 1836 : 1634;              /* 1.793 / 1.596 */
+   const int cgu = bt709 ? 218 : 401;                /* 0.213 / 0.392 */
+   const int cgv = bt709 ? 546 : 833;                /* 0.533 / 0.813 */
+   const int cbu = bt709 ? 2163 : 2066;              /* 2.112 / 2.017 */
+
+   for (uint32_t row = 0; row < h; row++) {
+      const uint8_t *yp = yuv + (uint64_t)row * stride;
+      const uint8_t *c0p = yuv + c0 + (uint64_t)(row / 2) * cstride;
+      const uint8_t *c1p = yuv + c1 + (uint64_t)(row / 2) * cstride;
+      uint8_t *out = rgba + (size_t)(invert ? h - 1 - row : row) * w * 4;
+      for (uint32_t x = 0; x < w; x++) {
+         int u, v;
+         if (nv12) {
+            u = c0p[(x / 2) * 2] - 128;
+            v = c0p[(x / 2) * 2 + 1] - 128;
+         } else {
+            v = c0p[x / 2] - 128;
+            u = c1p[x / 2] - 128;
+         }
+         const int y = cy * (yp[x] - 16);
+         out[0] = vrend_clamp_u8((y + crv * v + 512) >> 10);
+         out[1] = vrend_clamp_u8((y - cgu * u - cgv * v + 512) >> 10);
+         out[2] = vrend_clamp_u8((y + cbu * u + 512) >> 10);
+         out[3] = 255;
+         out += 4;
+      }
+   }
+}
+
+static int vrend_yuv_emulated_transfer(struct vrend_resource *res,
+                                       const struct iovec *iov, int num_iovs,
+                                       const struct vrend_transfer_info *info,
+                                       int transfer_mode)
+{
+   if (transfer_mode != VIRGL_TRANSFER_TO_HOST)
+      return 0;
+
+   const bool nv12 = res->base.format == VIRGL_FORMAT_NV12;
+   const uint32_t w = res->base.width0, h = res->base.height0;
+   const uint32_t stride = info->stride ? info->stride : (info->level ? (uint32_t)info->level : w);
+   if (!w || !h || stride < w)
+      return EINVAL;
+
+   const uint32_t cw = (w + 1) / 2, ch = (h + 1) / 2;
+   const uint32_t cstride = nv12 ? stride : stride / 2;
+   const uint64_t y_size = info->layer_stride ? info->layer_stride : (uint64_t)stride * h;
+   const uint64_t c_size = info->layer_stride ? (nv12 ? info->layer_stride / 2 : info->layer_stride / 4)
+                                              : (uint64_t)cstride * (h / 2);
+   const uint64_t c0 = y_size;                       /* V (YV12) or UV (NV12) */
+   const uint64_t c1 = y_size + c_size;              /* U (YV12) */
+   const uint64_t total = nv12 ? c0 + (uint64_t)cstride * ch : c1 + (uint64_t)cstride * ch;
+   if (total > UINT32_MAX)
+      return EINVAL;
+
+   uint8_t *yuv = calloc(1, total);
+   uint8_t *scratch = malloc((size_t)w * h * 4);
+   if (!yuv || !scratch) {
+      free(yuv);
+      free(scratch);
+      return ENOMEM;
+   }
+   vrend_read_from_iovec(iov, num_iovs, info->offset, (char *)yuv, total);
+   const bool invert = vrend_state.use_core_profile && res->y_0_top;
+
+   GLint unpack_buffer = 0, row_length = 0, skip_rows = 0, skip_pixels = 0, alignment = 4;
+   glGetIntegerv(GL_PIXEL_UNPACK_BUFFER_BINDING, &unpack_buffer);
+   glGetIntegerv(GL_UNPACK_ROW_LENGTH, &row_length);
+   glGetIntegerv(GL_UNPACK_SKIP_ROWS, &skip_rows);
+   glGetIntegerv(GL_UNPACK_SKIP_PIXELS, &skip_pixels);
+   glGetIntegerv(GL_UNPACK_ALIGNMENT, &alignment);
+   glBindBuffer(GL_PIXEL_UNPACK_BUFFER, 0);
+   glPixelStorei(GL_UNPACK_ROW_LENGTH, 0);
+   glPixelStorei(GL_UNPACK_SKIP_ROWS, 0);
+   glPixelStorei(GL_UNPACK_SKIP_PIXELS, 0);
+   glPixelStorei(GL_UNPACK_ALIGNMENT, 1);
+
+   if (vrend_yuv_planes_ensure(res)) {
+      vrend_yuv_upload_plane(res->yuv_plane_tex[0], GL_RED, 1, w, h, yuv, stride, invert, scratch);
+      if (nv12) {
+         vrend_yuv_upload_plane(res->yuv_plane_tex[1], GL_RG, 2, cw, ch, yuv + c0, cstride, invert, scratch);
+      } else {
+         vrend_yuv_upload_plane(res->yuv_plane_tex[1], GL_RED, 1, cw, ch, yuv + c0, cstride, invert, scratch);
+         vrend_yuv_upload_plane(res->yuv_plane_tex[2], GL_RED, 1, cw, ch, yuv + c1, cstride, invert, scratch);
+      }
+   }
+
+   if (res->yuv_rgba_wanted) {
+      vrend_yuv_to_rgba(res, yuv, stride, cstride, c0, c1, invert, scratch);
+      glBindTexture(res->target, res->gl_id);
+      glTexSubImage2D(res->target, 0, 0, 0, w, h, GL_RGBA, GL_UNSIGNED_BYTE, scratch);
+   }
+   glBindTexture(GL_TEXTURE_2D, 0);
+
+   glBindBuffer(GL_PIXEL_UNPACK_BUFFER, unpack_buffer);
+   glPixelStorei(GL_UNPACK_ROW_LENGTH, row_length);
+   glPixelStorei(GL_UNPACK_SKIP_ROWS, skip_rows);
+   glPixelStorei(GL_UNPACK_SKIP_PIXELS, skip_pixels);
+   glPixelStorei(GL_UNPACK_ALIGNMENT, alignment);
+
+   static unsigned logged;
+   if (logged < 3) {
+      logged++;
+      fprintf(stderr, "[husk-yuv] %s frame %ux%u: stride %u, layer_stride %u, offset %u, box %d,%d %dx%d%s%s\n",
+              nv12 ? "NV12" : "YV12", w, h, stride, info->layer_stride, (unsigned)info->offset,
+              info->box->x, info->box->y, info->box->width, info->box->height,
+              invert ? ", inverted" : "", res->yuv_rgba_wanted ? ", +rgba" : "");
+   }
+   free(yuv);
+   free(scratch);
+   return 0;
+}
+#endif
+
 static int vrend_renderer_transfer_internal(struct vrend_context *ctx,
                                             struct vrend_resource *res,
                                             const struct vrend_transfer_info *info,
@@ -10275,6 +10496,13 @@ static int vrend_renderer_transfer_internal(struct vrend_context *ctx,
    }
 #endif
 
+#if !(defined(HAVE_EPOXY_EGL_H) && defined(ENABLE_GBM_ALLOCATION))
+   /* Before the bounds checks: they size the transfer from the format, and a planar format has no
+    * per-pixel size to give them. `level` carries the stride here, not a mip level. */
+   if (vrend_format_is_yuv_emulated(res->base.format))
+      return vrend_yuv_emulated_transfer(res, iov, num_iovs, info, transfer_mode);
+#endif
+
    if (!resource_contains_box(res, info->box, info->level)) {
       vrend_report_context_error(ctx, VIRGL_ERROR_CTX_TRANSFER_IOV_BOUNDS, res->gl_id);
       return EINVAL;
