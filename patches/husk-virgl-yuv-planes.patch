+/* HuskDroid: the per-plane textures of an emulated YV12/NV12 resource, made on first use. */
+static bool vrend_yuv_planes_ensure(struct vrend_resource *res)
+{
+   if (res->yuv_plane_tex[0])
+      return true;
+   const bool nv12 = res->base.format == VIRGL_FORMAT_NV12;
+   const GLsizei w = res->base.width0, h = res->base.height0;
+   const GLsizei cw = (w + 1) / 2, ch = (h + 1) / 2;
+   const int planes = nv12 ? 2 : 3;
+   glGenTextures(planes, res->yuv_plane_tex);
+   for (int i = 0; i < planes; i++) {
+      const bool uv = nv12 && i == 1;
+      glBindTexture(GL_TEXTURE_2D, res->yuv_plane_tex[i]);
+      glTexImage2D(GL_TEXTURE_2D, 0, uv ? GL_RG8 : GL_R8, i ? cw : w, i ? ch : h, 0,
+                   uv ? GL_RG : GL_RED, GL_UNSIGNED_BYTE, NULL);
+      /* Complete without mipmaps whatever sampler state arrives later. */
+      glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAX_LEVEL, 0);
+      glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_LINEAR);
+      glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_LINEAR);
+      glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_S, GL_CLAMP_TO_EDGE);
+      glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_T, GL_CLAMP_TO_EDGE);
+   }
+   glBindTexture(GL_TEXTURE_2D, 0);
+   static unsigned logged;
+   if (logged < 3) {
+      logged++;
+      fprintf(stderr, "[husk-yuv] %s resource %ux%u: %d plane textures\n",
+              nv12 ? "NV12" : "YV12", res->base.width0, res->base.height0, planes);
+   }
+   return true;
+}
