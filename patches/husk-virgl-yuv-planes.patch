+        static const enum virgl_formats yuv[] = { VIRGL_FORMAT_YV12, VIRGL_FORMAT_NV12 };
+        for (unsigned i = 0; i < ARRAY_SIZE(yuv); i++) {
+           struct vrend_format_table entry = *rgba;
+           entry.format = yuv[i];
+           vrend_insert_format(&entry, VIRGL_BIND_SAMPLER_VIEW,
+                               rgba->flags & VIRGL_TEXTURE_CAN_TEXTURE_STORAGE);
+        }
+     }
+  }
+#endif
 }
 
 
