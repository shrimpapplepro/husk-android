+#if !(defined(HAVE_EPOXY_EGL_H) && defined(ENABLE_GBM_ALLOCATION))
+  /* HuskDroid: video frames (YV12, NV12) without GBM.
+   *
+   * A Linux host samples these through an EGL image of a GBM buffer, and the driver converts YUV to
+   * RGB on sampling. Without GBM (iOS: ANGLE on Metal) that path does not exist, the formats were not
+   * advertised, and the guest's minigbm faked YV12 as one R8 texture, which its GL driver then sampled
