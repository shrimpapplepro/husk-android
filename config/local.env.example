# HuskDroid's machine-specific values. Copy to config/local.env (ignored by git) and fill in.
# Read by src/huskdroid/build.sh, tools/companion/install.sh (which copies it to
# ~/.config/huskdroid/config.env for the companion), and through them by the app.

# The iPhone: `xcrun devicectl list devices`
HUSKDROID_UDID=00000000-0000000000000000
# Where the companion reaches the iPhone, tried in order (Wi-Fi first; see AGENTS.md, Network)
HUSKDROID_PHONE_HOSTS=192.168.1.20,100.64.0.20
# Where the app reaches the companion on the Mac, tried in order
# host:port is plain HTTP; a full https URL (a Tailscale Funnel to port 8790) keeps its path. Last = tried last.
HUSKDROID_MAC_HOSTS=192.168.1.10:8790,100.64.0.10:8790,https://mac.tailnet-name.ts.net/huskdroid
# Paid Apple developer team that signs the app (the bundle id becomes com.shrimpapplepro.huskdroid.<TEAM>)
HUSKDROID_TEAM=ABCDE12345
